{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://franchise-platform.local/schemas/deliverable.schema.json",
  "title": "ClientDeliverable",
  "description": "Schema definition for tracking client deliverables and approval status",
  "type": "object",
  "required": [
    "deliverableId",
    "clientId",
    "title",
    "category",
    "filePath",
    "status",
    "version"
  ],
  "properties": {
    "deliverableId": {
      "type": "string",
      "pattern": "^DEL-[0-9]{3,}$"
    },
    "clientId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Financial Model",
        "Pitch Deck",
        "Franchise Prospectus",
        "Franchise Brochure",
        "Legal Agreement",
        "Operations Handbook",
        "Market Research",
        "Territory Plan"
      ]
    },
    "filePath": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in_review", "peer_approved", "client_signed_off"]
    },
    "leadAnalyst": {
      "type": "string"
    },
    "reviewerAnalyst": {
      "type": "string"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
