{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://franchise-platform.local/schemas/product.schema.json",
  "title": "ProductCatalog",
  "description": "Schema definition for a client's product catalog and commercial parameters",
  "type": "object",
  "required": [
    "clientId",
    "products"
  ],
  "properties": {
    "clientId": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "productId",
          "name",
          "category",
          "deliveryModel",
          "targetCustomerSegment",
          "indicativePriceNet",
          "pricingModel"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "deliveryModel": {
            "type": "string",
            "enum": ["SaaS", "On-Premise", "Hybrid", "Cloud", "Physical Service", "Hardware+Software"]
          },
          "targetCustomerSegment": {
            "type": "string"
          },
          "indicativePriceNet": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "default": "INR"
          },
          "pricingModel": {
            "type": "string",
            "enum": ["Annual Subscription", "Perpetual License", "One-Time Project", "Per-Transaction", "Monthly Subscription"]
          },
          "implementationFeeNet": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "estimatedAnnualRenewalNet": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "salesCycleDays": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
